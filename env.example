# Copy these variable NAMES into Vercel -> Project -> Settings -> Environment
# Variables (or into a local .env.local for `vercel dev`). Never commit real keys.

# The Movie Database key (already used by /api/tmdb).
TMDB_KEY=

# Experimental AI Search (Groq). Comma-separated, no spaces required.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy,gsk_zzz
GROQ_API_KEYS=

# Optional fallback keys, tried only after every primary key is exhausted.
GROQ_FALLBACK_KEYS=

# Optional: override the default model.
# GROQ_MODEL=llama-3.3-70b-versatile
